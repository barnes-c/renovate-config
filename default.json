{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Shared Renovate preset for my repositories.",
    "extends": [
        "config:best-practices",
        ":semanticCommits"
    ],
    "labels": [
        "dependencies"
    ],
    "pinDigests": true,
    "platformAutomerge": true,
    "osvVulnerabilityAlerts": true,
    "minimumReleaseAge": "1 day",
    "internalChecksFilter": "none",
    "customManagers": [
        {
            "description": "Container images run via `docker run` in workflow scripts, which the github-actions manager does not parse.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "(?<depName>(?:docker\\.io|ghcr\\.io)/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "patch",
                "digest",
                "pin",
                "pinDigest"
            ],
            "automerge": true
        },
        {
            "description": "Workflow input fields (e.g. golangci-lint-action `version:`, setup-go `go-version:`) cannot carry a digest comment, so pinDigests fails the branch.",
            "matchDepTypes": [
                "uses-with"
            ],
            "pinDigests": false
        },
        {
            "description": "slsa-github-generator reusable workflows must stay tag-pinned; their builder script rejects SHA refs.",
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "slsa-framework/slsa-github-generator"
            ],
            "pinDigests": false
        },
        {
            "matchManagers": [
                "bun",
                "npm"
            ],
            "matchDepTypes": [
                "devDependencies"
            ],
            "groupName": "dev dependencies"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions"
        },
        {
            "matchManagers": [
                "dockerfile"
            ],
            "groupName": "docker base images"
        }
    ]
}